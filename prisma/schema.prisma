// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./client"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id        String   @id @default(cuid())
  order     Int      @default(0)
  title     String
  tech      String
  url       String   @default("#")
  year      String
  desc      String   @default("")
  img       String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TechCategory {
  id        String     @id @default(cuid())
  order     Int        @default(0)
  label     String
  items     TechItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model TechItem {
  id           String       @id @default(cuid())
  name         String
  category     TechCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId   String
}
